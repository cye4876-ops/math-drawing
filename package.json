{
  "name": "math-drawing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "postinstall": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "lint-staged": "^17.6.0",
    "nerdamer": "^1.1.13",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,svelte,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lucide/svelte": "^1.50.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "katex": "^0.18.9",
    "three": "^0.186.1"
  }
}
